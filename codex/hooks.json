{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-agent-usage-logger.exe",
            "commandWindows": "%USERPROFILE%\\.codex\\hooks\\codex-agent-usage-logger.exe",
            "timeout": 10,
            "statusMessage": "Logging session start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-agent-usage-logger.exe",
            "commandWindows": "%USERPROFILE%\\.codex\\hooks\\codex-agent-usage-logger.exe",
            "timeout": 10,
            "statusMessage": "Logging user prompt"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-agent-usage-logger.exe",
            "commandWindows": "%USERPROFILE%\\.codex\\hooks\\codex-agent-usage-logger.exe",
            "timeout": 10,
            "statusMessage": "Logging subagent start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-agent-usage-logger.exe",
            "commandWindows": "%USERPROFILE%\\.codex\\hooks\\codex-agent-usage-logger.exe",
            "timeout": 10,
            "statusMessage": "Logging subagent stop"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-agent-usage-logger.exe",
            "commandWindows": "%USERPROFILE%\\.codex\\hooks\\codex-agent-usage-logger.exe",
            "timeout": 10,
            "statusMessage": "Logging tool use"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-agent-usage-logger.exe",
            "commandWindows": "%USERPROFILE%\\.codex\\hooks\\codex-agent-usage-logger.exe",
            "timeout": 10,
            "statusMessage": "Logging turn stop"
          }
        ]
      }
    ]
  }
}
